@echo off
chcp 65001 >nul
:: ============================================================
:: AI出現モニタリング 実行スクリプト（手動・対話メニュー版）
:: 株式会社オンワードコーポレートデザイン
::
:: 【使い方】
:: ・このファイルは monitoring フォルダ内に置いてください
:: ・ダブルクリックすると、観測するLLMを選ぶメニューが表示されます
::     1) GPT-4o  2) Gemini  3) Perplexity  4) Claude  a) 全て
:: ・番号を入力してEnterを押すと、そのモデルだけで実行します
:: ・自動実行（タスクスケジューラ）には monitoring_run_all.bat を使ってください
::
:: 【パス設定不要】
:: このバッチファイルが置かれているフォルダを自動で取得します。
:: BOX・OneDrive・ローカルなど、どこに置いても変更不要です。
:: ============================================================

:: このバッチファイルが置かれているフォルダを自動取得（末尾の \ を除去）
set MONITORING_DIR=%~dp0
if "%MONITORING_DIR:~-1%"=="\" set MONITORING_DIR=%MONITORING_DIR:~0,-1%

:: Python のパス（通常はそのままでOK）
set PYTHON=python

cd /d "%MONITORING_DIR%"

:: 対話メニューを表示（メニュー・進捗はこのウィンドウに表示されます）
%PYTHON% src\runner.py

echo.
echo ============================================================
echo  完了しました。結果は data\results などに保存されています。
echo ============================================================
pause
