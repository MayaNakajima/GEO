# ============================================================
# AI Citation Monitoring — 環境変数設定ファイル
# このファイルをコピーして .env にリネームし、各値を入力してください
# ============================================================

# ---- LLM API キー ----
OPENAI_API_KEY=sk-...           # OpenAI (GPT-4o)
ANTHROPIC_API_KEY=sk-ant-...    # Anthropic (Claude)
GOOGLE_API_KEY=AIza...          # Google AI Studio (Gemini)
PERPLEXITY_API_KEY=pplx-...     # Perplexity
XAI_API_KEY=xai-...             # xAI (Grok) ※ 任意

# ---- Microsoft Teams 通知 ----
# Teams チャンネルの「コネクタ」→「Incoming Webhook」で取得した URL を設定
# 設定手順:
#   1. 通知を送りたい Teams チャンネルを開く
#   2. チャンネル名の右クリック → コネクタ → Incoming Webhook → 構成
#   3. 名前「AI出現モニタリング」、アイコンを設定して「作成」
#   4. 表示された URL をコピーしてここに貼り付け
TEAMS_WEBHOOK_URL=https://xxx.webhook.office.com/webhookb2/...
